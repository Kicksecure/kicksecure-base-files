#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

if [ -f /usr/libexec/helper-scripts/pre.bsh ]; then
   source /usr/libexec/helper-scripts/pre.bsh
fi

set -e

true "
#####################################################################
## INFO: BEGIN: $DPKG_MAINTSCRIPT_PACKAGE $DPKG_MAINTSCRIPT_NAME $@
#####################################################################
"

## Symlink all shared GRUB theme files.
## Fall back to copying them if creating the symlink fails, because /boot may
## be a FAT32 partition (for example the EFI system partition), which does not
## support symlinks.
readarray -t grub_theme_common_file_list < <(cd '/boot/grub/themes/dist-common'; find -mindepth 1 -maxdepth 1 | sed 's/^.\///')
for grub_theme_common_file in "${grub_theme_common_file_list[@]}"; do
   rm -rf "/boot/grub/themes/kicksecure/${grub_theme_common_file}"
   if ! ln -s "../dist-common/${grub_theme_common_file}" "/boot/grub/themes/kicksecure/${grub_theme_common_file}" 2>/dev/null; then
      cp -r -- "/boot/grub/themes/dist-common/${grub_theme_common_file}" "/boot/grub/themes/kicksecure/${grub_theme_common_file}"
   fi
done

## https://phabricator.whonix.org/T377
## Debian has no update-grub trigger yet:
## https://bugs.debian.org/481542
if command -v update-grub >/dev/null 2>&1; then
   update-grub || \
      echo "$DPKG_MAINTSCRIPT_PACKAGE $DPKG_MAINTSCRIPT_NAME ERROR: Running \
'update-grub' failed with exit code $?. $DPKG_MAINTSCRIPT_PACKAGE is most \
likely only the trigger, not the cause. Unless you know this is not an issue, \
you should fix running 'update-grub', otherwise your system might no longer \
boot." >&2
fi

case "$1" in
   configure)
      true "INFO: Configuring $DPKG_MAINTSCRIPT_PACKAGE..."

      ## 70_dpkg_origins {{
      ## || true to support re-running the script
      ## Get rid of old symlink.
      #unlink /etc/dpkg/origins/default || true
      #ln -s /etc/dpkg/origins/kicksecure /etc/dpkg/origins/default || true
      ## 70_dpkg_origins }}

      true "INFO: End configuring $DPKG_MAINTSCRIPT_PACKAGE."

      ;;

   *)
      ;;
esac

true "INFO: debhelper beginning here."

#DEBHELPER#

true "INFO: Done with debhelper."

true "
#####################################################################
## INFO: END  : $DPKG_MAINTSCRIPT_PACKAGE $DPKG_MAINTSCRIPT_NAME $@
#####################################################################
"

## Explicitly "exit 0", so eventually trapped errors can be ignored.
exit 0
